# Copy to .env and adjust. Everything has a working default for a local demo.

# Database password (use URL-safe characters; it is embedded in DATABASE_URL)
POSTGRES_PASSWORD=change-me

# Company timezone. ZKTeco devices send local wall-clock times; they are interpreted in this zone.
TZ_DEFAULT=Asia/Dhaka

# true = create demo employees, punches, leave and payroll on first start. Set false for a real deployment.
SEED_DEMO=true

# Used when SEED_DEMO=false: the first admin account. Leave ADMIN_PASSWORD empty to have one generated and printed in the logs.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=

# Optional. If empty, signing keys (JWT + Web Push VAPID) are generated on first boot and stored in the database.
JWT_SECRET=
VAPID_SUBJECT=mailto:admin@yourcompany.com

# Host port for the app (devices push here over plain HTTP)
APP_PORT=3000

# HTTPS profile (docker compose --profile https up -d)
DOMAIN=attendance.yourcompany.com
TRUST_PROXY=1
